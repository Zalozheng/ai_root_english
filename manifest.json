{
  "manifest_version": 3,
  "name": "Ai词根分析",
  "short_name": "词根引擎",
  "version": "30.0.7",
  "default_locale": "zh_CN",
  "description": "Ai词根分析,用大模型对单词进行拆分,方便记忆",
  "icons": {
    "16": "icons/ui_128.png",
    "48": "icons/ui_128.png",
    "128": "icons/ui_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extShortName__",
    "default_icon": {
      "16": "icons/ui_128.png",
      "48": "icons/ui_128.png",
      "128": "icons/ui_128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tts",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "description": "词根分析"
    }
  },
  "web_accessible_resources": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "resources": ["popup.html", "icons/ui_128.png", "options.html", "js/*","css/*", "js/popup/*"],
      "use_dynamic_url": false
    }
  ]
}