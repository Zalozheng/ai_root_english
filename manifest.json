{
  "manifest_version": 3,
  "name": "AI词根记忆 Pro",
  "short_name": "AI词根记忆",
  "version": "26.0.1",
  "description": "智能英语词汇解析工具：一键拆解词根词缀，结合 AI 生成记忆故事与情景例句，支持 Ollama 本地模型与云端 API 双模式，让每个单词深入脑海。",
  "icons": {
    "16": "icons/ui_16.png",
    "24": "icons/ui_24.png",
    "32": "icons/ui_32.png",
    "64": "icons/ui_64.png",
    "128": "icons/ui_128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tts",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI词根记忆 Pro"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "description": "呼出 AI 词汇解析面板（可在扩展快捷键设置中自定义）"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "popup.html",
        "popup.js",
        "options.html",
        "icons/*",
        "js/*"
      ],
      "use_dynamic_url": false
    }
  ]
}
